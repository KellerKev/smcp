# SCP Environment Variables Example
# Copy this to .env and modify values as needed

# Core SCP Settings
SCP_NODE_ID=my_scp_node
#
# Secrets below MUST be strong, per-deployment values. The server/client refuse
# to start otherwise (min 32 chars for keys, 16 for the salt; publicly-known
# placeholders are rejected). Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Share SCP_SECRET_KEY / SCP_JWT_SECRET / SCP_KDF_SALT across federated nodes.
SCP_API_KEY=CHANGE_ME_generate_a_32char_random_value
SCP_SECRET_KEY=CHANGE_ME_generate_a_32char_random_value
SCP_JWT_SECRET=CHANGE_ME_generate_a_32char_random_value
SCP_KDF_SALT=CHANGE_ME_generate_a_16char_random_value

# Server Settings
SCP_HOST=localhost
SCP_PORT=8765
SCP_MAX_CONNECTIONS=100

# Client Settings
SCP_SERVER_URL=ws://localhost:8765
SCP_TIMEOUT=30
SCP_MAX_RETRIES=3

# AI Integration
SCP_OLLAMA_URL=http://localhost:11434
SCP_DEFAULT_MODEL=tinyllama:latest

# Security
SCP_MAX_MESSAGE_SIZE=1048576
SCP_TOKEN_EXPIRY=3600

# Logging
SCP_LOG_LEVEL=INFO
SCP_LOG_FILE=/var/log/scp.log